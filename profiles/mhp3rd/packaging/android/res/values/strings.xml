<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Yakumo</string>
    <!-- The window reaches into a display cutout on the short edges (the
         sides, in landscape) from the moment it is made; otherwise Android
         keeps the window beside the cutout and fills that strip with black. -->
    <style name="AppTheme" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
