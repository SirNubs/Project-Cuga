# Guard build-directory copies only. The user's generated corpus stays intact.
function(mhp2g_guard_fuc_gather output)
    set(guarded)
    foreach(source IN LISTS ARGN)
        # Other overlays reuse these addresses with different meanings.
        if(NOT source MATCHES "/generated/" AND NOT source MATCHES "_(game_task|lobby_task)_")
            list(APPEND guarded "${source}")
            continue()
        endif()
        file(READ "${source}" original)
        string(REPLACE "\r\n" "\n" original "${original}")
        set(content "${original}")
        foreach(site 0884E158 0884E730 0886CFE8 09A630C0 09A9CBA4 09AAA0F0 09AAA0F8)
            string(REPLACE "L_${site}:\n"
                "L_${site}:\n    if (mhp2g::follow_fuc_gather_hook(rt, ctx, aot_mem, 0x${site}u)) return;\n"
                content "${content}")
        endforeach()
        if(content STREQUAL original)
            list(APPEND guarded "${source}")
        else()
            set(content "#include \"mods/fuc_runtime_hooks.hpp\"\n${content}")
            file(RELATIVE_PATH relative "${MHP2G_PROFILE_DIR}" "${source}")
            set(destination "${CMAKE_CURRENT_BINARY_DIR}/fuc_guarded/${relative}")
            file(CONFIGURE OUTPUT "${destination}" CONTENT "${content}" @ONLY)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
            list(APPEND guarded "${destination}")
        endif()
    endforeach()
    set(${output} "${guarded}" PARENT_SCOPE)
endfunction()
